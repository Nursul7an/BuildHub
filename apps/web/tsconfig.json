{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    // Типы vite/client намеренно не подключаем: проверка типов не должна
    // падать из-за того, что на площадке сборки не оказалось пакета.
    // Нужные три поля объявлены в src/vite-env.d.ts.
    "types": [],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // vite.config.ts из проверки исключён: он импортирует сам vite, и
  // проверка типов снова зависела бы от того, что пакет установлен.
  // Свой конфиг vite разбирает при сборке и об ошибке скажет сам.
  "include": ["src"]
}
