{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "."
  },
  // prisma/ не компилируем: seed и фикстуры запускаются через tsx, а при
  // rootDir="." вывод уезжал в dist/src/index.js — мимо "start" из
  // package.json, то есть развёрнутый сервер просто не находил точку входа.
  "include": ["src"]
}
