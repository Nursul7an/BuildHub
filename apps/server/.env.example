# Настройки сервера. Скопируйте в .env для локальной работы:
#   cp apps/server/.env.example apps/server/.env
#
# В проде (NODE_ENV=production) сервер откажется стартовать без JWT_SECRET
# или с отладочным значением из репозитория — см. src/config.ts.

# --- Обязательные ------------------------------------------------------

DATABASE_URL="postgresql://buildhub:buildhub@127.0.0.1:5432/buildhub?schema=public"

# Секрет подписи токенов. Сгенерировать: openssl rand -hex 32
JWT_SECRET="build-hub-dev-secret-change-me"

# --- Необязательные ----------------------------------------------------

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Отдельный секрет для ссылок на файлы. Пусто — берётся JWT_SECRET.
# FILE_SIGNING_SECRET=

# Каталог загрузок. На контейнерном хостинге обязан указывать на
# подключённый том, иначе фотографии пропадут при перезапуске.
# FILE_STORAGE_DIR=var/uploads

# Адреса фронтенда через запятую. Пусто — разрешён любой источник
# (годится для разработки, не для прода).
# WEB_ORIGIN=https://build-hub.vercel.app

# Токен для выгрузки /metrics. Пусто — ручка открыта без токена.
# METRICS_TOKEN=

# Refresh-токен браузера лежит в httpOnly cookie. Если фронтенд и API
# на разных сайтах (vercel.app и onrender.com), браузер не пошлёт её
# со значением lax — нужно none, а оно требует HTTPS.
#
# Лучше свести обе части под один домен (app.example.kg и api.example.kg)
# и оставить lax: сторонние cookie браузеры постепенно перестают
# принимать вовсе, и none — это отложенная поломка.
# REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=.example.kg

# Цели по SLA из ТЗ §11, миллисекунды.
# SLA_READ_P95_MS=400
# SLA_WRITE_P95_MS=800

# Общий лимит запросов на пользователя в минуту.
# RATE_LIMIT_PER_MINUTE=300
