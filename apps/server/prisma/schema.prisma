// Build Hub — схема данных.
// Выведена из прототипа `project/Прототип - всё приложение.dc.html`: сущности и связи
// повторяют то, что прототип показывает на экранах, включая шлюзы (АОСР, протокол
// прочности) — они здесь ограничения, а не подсказки в интерфейсе.
//
// SQLite: перечисления хранятся строками, списки — JSON-строками.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Пользователи и доступ ───────────────────────────

model User {
  id       String @id @default(cuid())
  fullName String
  login    String @unique
  phone    String
  /// prorab | master | pto | dir | gi | snab | sklad | tech
  role     String

  passwordHash       String
  /// Пароль выдаётся один раз; до смены пускаем только на экран смены пароля.
  mustChangePassword Boolean @default(true)
  active             Boolean @default(true)

  objectId   String?
  object     ConstructionObject? @relation(fields: [objectId], references: [id])
  blockId    String?
  block      Block?              @relation(fields: [blockId], references: [id])
  /// «весь блок» / «5 этаж — захватка»
  scopeLabel String?

  createdAt DateTime @default(now())

  reports            DailyReport[]         @relation("reportAuthor")
  zayavkiAuthored    Zayavka[]             @relation("zayavkaAuthor")
  zayavkiHeld        Zayavka[]             @relation("zayavkaHolder")
  tasksAssigned      Task[]                @relation("taskAssignee")
  tasksAuthored      Task[]                @relation("taskAuthor")
  notifications      Notification[]
  prescriptionsGiven Prescription[]
  acceptances        MaterialAcceptance[]
  issuesReceived     MaterialIssue[]
  rfis               Rfi[]
  responsibleFor     ConstructionObject[]  @relation("objectResponsible")
  zayavkaEvents      ZayavkaEvent[]
  reportChecks       ReportCheck[]
  contractorRatings  ContractorRating[]
  payments           Payment[]             @relation("paymentApprover")

  @@index([role])
}

// ─────────────────────────── Объекты и иерархия ───────────────────────────

model ConstructionObject {
  id      String @id @default(cuid())
  /// Короткий код для номеров заявок: АКО, БЦ, ДЖР
  code    String @unique
  name    String
  address String
  city    String

  floorsTotal Int
  dueDate     DateTime
  /// active | paused | done
  status      String @default("active")

  /// Готовность по графику ПТО и по факту. Отклонение в днях — то, на что
  /// руководство смотрит первым: проценты без срока ничего не решают.
  pctPlan   Float @default(0)
  pctFact   Float @default(0)
  deltaDays Int   @default(0)

  responsibleUserId String?
  responsible       User?   @relation("objectResponsible", fields: [responsibleUserId], references: [id])

  blocks        Block[]
  users         User[]
  processes     ProcessState[]
  reports       DailyReport[]
  zayavki       Zayavka[]
  stock         StockBalance[]
  documents     SiteDocument[]
  drawingSets   DrawingSet[]
  rfis          Rfi[]
  tasks         Task[]
  incidents     Incident[]
  finance       ObjectFinance?
  payments      Payment[]
  protocols     ConcreteStrengthProtocol[]
  issues        MaterialIssue[]
  costArticles  CostArticle[]
}

model Block {
  id       String             @id @default(cuid())
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  name     String
  floors   Int

  processes ProcessState[]
  users     User[]
  zayavki   Zayavka[]
  tasks     Task[]

  @@unique([objectId, name])
}

// ─────────────────────────── Разделы и процессы ───────────────────────────

model SectionDef {
  id   String @id
  name String @unique
  /// Условие входа в раздел — печатается вверху цепочки.
  entryCondition String?
  /// Общая причина блокировки раздела, если он не может стартовать.
  blockReason    String?
  sortOrder      Int     @default(0)

  processes ProcessDef[]
  tasks     Task[]
}

model ProcessDef {
  id        String     @id @default(cuid())
  sectionId String
  section   SectionDef @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order     Int
  name      String
  /// т | кг | м³ | м² | пог. м | шт | точки | партия | сут | —
  unit      String
  /// Замок в интерфейсе: по завершении нужен АОСР.
  requiresAosr Boolean @default(false)
  /// «Подцикл А · Колонны и стены» — только у монолита.
  subcycle     String?
  /// ⚠️ в названии: отступление несёт риск.
  critical     Boolean @default(false)

  states ProcessState[]

  @@unique([sectionId, order])
}

model ProcessState {
  id           String     @id @default(cuid())
  processDefId String
  processDef   ProcessDef @relation(fields: [processDefId], references: [id], onDelete: Cascade)

  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  blockId  String
  block    Block              @relation(fields: [blockId], references: [id], onDelete: Cascade)
  floor    Int

  /// idle | active | presented | accepted | blocked
  status   String @default("idle")
  planQty  Float  @default(0)
  doneQty  Float  @default(0)
  /// Причина блокировки видна в строке цепочки, а не в диалоге.
  blockedReason String?
  dueDate       DateTime?

  presentedAt     DateTime?
  presentedOfDays Int?
  aosrNumber      String?
  acceptedAt      DateTime?

  assigneeUserId String?

  entries     ReportEntry[]
  comments    ProcessComment[]
  zayavki     Zayavka[]
  documents   SiteDocument[]
  protocols   ConcreteStrengthProtocol[]
  presentations Presentation[]

  @@unique([processDefId, blockId, floor])
  @@index([objectId, status])
}

model ProcessComment {
  id             String       @id @default(cuid())
  processStateId String
  processState   ProcessState @relation(fields: [processStateId], references: [id], onDelete: Cascade)
  /// problem | delay | material | quality | safety | other
  kind      String
  text      String
  authorId  String
  createdAt DateTime @default(now())

  /// Для «нехватки материала» — что и сколько.
  materialName String?
  materialQty  Float?
  materialUnit String?
  neededBy     DateTime?

  /// Для «проблема / простой» — сколько людей стоит и с какого времени.
  idleWorkers Int?
  idleSince   DateTime?
  idleCost    Float?

  zayavkaId String?
}

/// Предъявление к освидетельствованию: извещение не позднее чем за 3 рабочих дня.
model Presentation {
  id             String       @id @default(cuid())
  processStateId String
  processState   ProcessState @relation(fields: [processStateId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  scheduledFor   DateTime
  /// JSON: [{key,label,checked}]
  checklist      String
  /// JSON: ["ПТО · Гульмира С.", …]
  notified       String
  /// pending | done | rejected
  status         String       @default("pending")
  authorId       String
}

// ─────────────────────────── Дневной отчёт ───────────────────────────

model DailyReport {
  id       String             @id @default(cuid())
  date     DateTime
  authorId String
  author   User               @relation("reportAuthor", fields: [authorId], references: [id])
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  /// draft | submitted | atForeman | atPto | adjusted | returned | accepted
  status      String  @default("draft")
  submittedAt DateTime?
  /// Сколько заняло заполнение — цель ≤ 5 минут, показывается автору.
  fillSeconds Int?

  returnComment String?
  /// JSON: ["entryId", …] — спорные поля подсвечиваются при исправлении.
  returnedFields String?

  entries ReportEntry[]
  checks  ReportCheck[]

  @@unique([date, authorId])
}

model ReportEntry {
  id       String      @id @default(cuid())
  reportId String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  processStateId String
  processState   ProcessState @relation(fields: [processStateId], references: [id])

  volume  Float
  unit    String
  workers Int

  /// JSON: ["нехватка материала", …]
  problems String @default("[]")

  /// Температура: воздух — всегда, смесь — где важна по ППР.
  tempAir Float?
  tempMix Float?
  /// Обязателен при t воздуха ниже +5 °C.
  winterMethod String?

  comment String?

  photos ReportPhoto[]
}

model ReportPhoto {
  id      String      @id @default(cuid())
  entryId String
  entry   ReportEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  url     String
  /// Геометка и время съёмки — подделать сложнее, чем подпись.
  takenAt DateTime
  lat     Float?
  lon     Float?
}

/// Решение ПТО по отчёту: подтвердить, скорректировать, вернуть.
model ReportCheck {
  id       String      @id @default(cuid())
  reportId String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId  String
  actor    User        @relation(fields: [actorId], references: [id])
  /// accept | adjust | return
  decision String
  comment  String?
  /// Корректировка объёма: было → стало, с причиной.
  entryId    String?
  adjustFrom Float?
  adjustTo   Float?
  createdAt  DateTime @default(now())
}

// ─────────────────────────── Заявки ───────────────────────────

model Zayavka {
  id     String @id @default(cuid())
  number String @unique
  /// material | tech
  kind   String
  /// draft | atForeman | new | normalizing | approved | purchasing | ordered | inTransit | delivered | accepted | closed | rejected
  status String @default("new")

  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  blockId  String?
  block    Block?             @relation(fields: [blockId], references: [id])
  floor    Int?

  processStateId String?
  processState   ProcessState? @relation(fields: [processStateId], references: [id])

  authorId String
  author   User   @relation("zayavkaAuthor", fields: [authorId], references: [id])
  holderId String?
  holder   User?  @relation("zayavkaHolder", fields: [holderId], references: [id])

  /// norm | urgent
  priority   String    @default("norm")
  /// Срок поставки, а не срок работы.
  deliveryBy DateTime?
  createdAt  DateTime  @default(now())

  /// Цена простоя: сколько людей стоит и с какого времени.
  idleWorkers Int?
  idleSince   DateTime?
  idleCost    Float?

  items       ZayavkaItem[]
  events      ZayavkaEvent[]
  techRequest TechRequest?
  acceptances MaterialAcceptance[]
}

model ZayavkaItem {
  id        String  @id @default(cuid())
  zayavkaId String
  zayavka   Zayavka @relation(fields: [zayavkaId], references: [id], onDelete: Cascade)

  /// Как написал прораб. Сохраняется всегда, даже если позиция опознана.
  rawText       String
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  qty  Float
  unit String
  note String?

  /// Остаток по спецификации на момент заявки — для сверки перерасхода.
  specRemainder   Float?
  overspendReason String?
}

model ZayavkaEvent {
  id        String   @id @default(cuid())
  zayavkaId String
  zayavka   Zayavka  @relation(fields: [zayavkaId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  status    String
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  note      String?
}

// ─────────────────────────── Спецтехника ───────────────────────────

model TechRequest {
  id        String  @id @default(cuid())
  zayavkaId String  @unique
  zayavka   Zayavka @relation(fields: [zayavkaId], references: [id], onDelete: Cascade)

  machineType String
  hours       Float
  date        DateTime
  timeFrom    String

  /// JSON: [{key,label,checked}] — без готового фронта заявка не уходит.
  frontChecklist String

  machineId  String?
  machine    Machine? @relation(fields: [machineId], references: [id])
  operatorId String?

  report TechReport?
}

model Machine {
  id   String @id @default(cuid())
  name String
  /// Кран | Экскаватор | Автобетононасос | Самосвал | Погрузчик
  kind String
  /// free | busy | repair
  status String @default("free")
  /// Дата следующего ТО — система обязана предупреждать заранее.
  nextServiceAt DateTime?
  /// Срок страховки / допуска.
  permitUntil   DateTime?

  requests TechRequest[]
}

model TechReport {
  id            String      @id @default(cuid())
  techRequestId String      @unique
  techRequest   TechRequest @relation(fields: [techRequestId], references: [id], onDelete: Cascade)

  hoursPlanned Float
  hoursActual  Float
  idleHours    Float  @default(0)
  idleReason   String?
  fuel         Float?
  faults       String?
  ratedById    String
  createdAt    DateTime @default(now())
}

// ─────────────────────────── Материалы и склад ───────────────────────────

model CatalogItem {
  id   String @id @default(cuid())
  name String @unique
  unit String
  /// JSON: формулировки прорабов, сопоставленные снабжением. Справочник растёт сам.
  aliases String @default("[]")

  zayavkaItems ZayavkaItem[]
  balances     StockBalance[]
  issues       MaterialIssue[]
}

model StockBalance {
  id            String             @id @default(cuid())
  objectId      String
  object        ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem        @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  qty  Float
  unit String
  /// Норматив по спецификации на оставшийся объём работ.
  specRemainder Float?
  hasPassport   Boolean @default(true)

  @@unique([objectId, catalogItemId])
}

model MaterialAcceptance {
  id        String  @id @default(cuid())
  zayavkaId String
  zayavka   Zayavka @relation(fields: [zayavkaId], references: [id], onDelete: Cascade)

  acceptedById String
  acceptedBy   User     @relation(fields: [acceptedById], references: [id])
  at           DateTime @default(now())

  /// Приёмка в два шага: сначала количество, затем паспорт и качество.
  qtyAccepted    Float
  passportOk     Boolean
  passportNumber String?
  discrepancy    String?
  /// JSON: [{url,takenAt,lat,lon}]
  photos String @default("[]")
}

model MaterialIssue {
  id            String             @id @default(cuid())
  objectId      String
  object        ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem        @relation(fields: [catalogItemId], references: [id])
  qty           Float
  toUserId      String
  toUser        User               @relation(fields: [toUserId], references: [id])
  at            DateTime           @default(now())
  /// Выдача под роспись.
  signature     String
}

// ─────────────────────────── Подрядчики ───────────────────────────

model Contractor {
  id    String @id @default(cuid())
  name  String
  scope String
  activeWorkers Int @default(0)

  /// Автоматическая часть рейтинга — считается из данных системы.
  autoOnTime Float @default(0)
  autoRework Float @default(0)
  autoSafety Float @default(0)
  autoDocs   Float @default(0)

  ratings       ContractorRating[]
  prescriptions Prescription[]
}

/// Субъективная часть — оценка прораба после этапа.
model ContractorRating {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  quality      Int
  safety       Int
  management   Int
  culture      Int
  comment      String?
  createdAt    DateTime   @default(now())
}

model Prescription {
  id           String     @id @default(cuid())
  number       String
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  issuedById   String
  issuedBy     User       @relation(fields: [issuedById], references: [id])
  /// safety | quality | project
  kind       String
  text       String
  location   String
  dueDays    Int
  issuedAt   DateTime  @default(now())
  resolvedAt DateTime?
  /// JSON: [{url,takenAt,lat,lon}]
  photos String @default("[]")
}

// ─────────────────────────── Проект и документы ───────────────────────────

model DrawingSet {
  id       String             @id @default(cuid())
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  /// П | РД | ИД — стадии разделяются обязательно.
  stage    String
  /// АР | КЖ | КМ | ЭОМ | ОВ | ВК | ГП | ПОС
  mark     String
  name     String
  revision String
  issuedAt DateTime

  sheets DrawingSheet[]
}

model DrawingSheet {
  id       String     @id @default(cuid())
  setId    String
  set      DrawingSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  number   String
  name     String
  revision String
  /// Контроль актуальности листа — главная функция раздела «Проект».
  isCurrent     Boolean   @default(true)
  supersededBy  String?
  changedAt     DateTime?
  changeSummary String?
  fileUrl       String?

  rfis Rfi[]
}

model Rfi {
  id       String             @id @default(cuid())
  number   String
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  authorId String
  author   User               @relation(fields: [authorId], references: [id])
  sheetId  String?
  sheet    DrawingSheet?      @relation(fields: [sheetId], references: [id])

  question   String
  createdAt  DateTime  @default(now())
  dueAt      DateTime?
  answer     String?
  answeredAt DateTime?
  /// open | answered | closed
  status     String    @default("open")
}

model SiteDocument {
  id       String             @id @default(cuid())
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  /// aosr | aook | concreteStrength | passport | journal | other
  kind      String
  number    String
  name      String
  createdAt DateTime @default(now())
  signedAt  DateTime?
  /// draft | pending | signed | rejected
  status    String   @default("draft")

  processStateId String?
  processState   ProcessState? @relation(fields: [processStateId], references: [id])
  fileUrl        String?
}

/// Протокол прочности бетона — шлюз: без него распалубка не открывается.
model ConcreteStrengthProtocol {
  id       String             @id @default(cuid())
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  processStateId String
  processState   ProcessState @relation(fields: [processStateId], references: [id], onDelete: Cascade)

  pouredAt    DateTime
  sampleAt    DateTime
  strengthPct Float
  requiredPct Float
  labName     String
  /// awaiting | passed | failed
  status      String @default("awaiting")
}

// ─────────────────────────── Финансы ───────────────────────────

model ObjectFinance {
  id       String             @id @default(cuid())
  objectId String             @unique
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  /// Млн сом.
  budget Float
  /// Освоено (earned value) и потрачено (actual cost).
  ev Float
  ac Float
  /// Закрыто актами — деньги, которые можно предъявить заказчику.
  closedByActs Float @default(0)
  receivable   Float @default(0)
}

model CostArticle {
  id       String             @id @default(cuid())
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  name     String
  amount   Float
  note     String?
}

model Payment {
  id       String             @id @default(cuid())
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  name     String
  amount   Float
  dueDate  DateTime
  /// draft | pending | approved | paid | overdue
  status   String @default("pending")

  approvedById String?
  approvedBy   User?   @relation("paymentApprover", fields: [approvedById], references: [id])
  /// Сумма выше лимита автономности — решение уходит директору.
  aboveLimit   Boolean @default(false)
}

/// До какой суммы роль решает сама. Настраивает директор.
model AutonomyLimit {
  id    String @id @default(cuid())
  role  String
  /// payment | zayavka | contractor
  scope String
  limit Float

  @@unique([role, scope])
}

// ─────────────────────────── Задачи, инциденты, уведомления ───────────────────────────

model Task {
  id       String             @id @default(cuid())
  text     String
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  blockId  String?
  block    Block?             @relation(fields: [blockId], references: [id])
  floor    Int?
  sectionId String?
  section   SectionDef? @relation(fields: [sectionId], references: [id])

  assigneeId String?
  assignee   User?   @relation("taskAssignee", fields: [assigneeId], references: [id])
  authorId   String
  author     User    @relation("taskAuthor", fields: [authorId], references: [id])

  dueDate DateTime
  /// open | done | overdue
  status  String @default("open")
  /// inbox | schedule | manual
  origin    String   @default("manual")
  sourceRef String?
  createdAt DateTime @default(now())

  incidents Incident[]
}

model Incident {
  id       String             @id @default(cuid())
  objectId String
  object   ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  /// idle | safety | quality | delay
  kind   String
  title  String
  detail String
  at     DateTime @default(now())

  workersIdle Int?
  /// Цена проблемы. В ленте руководства каждая проблема имеет цену.
  cost        Float?
  /// open | assigned | resolved
  status String @default("open")

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])
}

model Notification {
  id     String @id @default(cuid())
  /// Кому — по роли и, если нужно, конкретному человеку.
  toRole String
  toUserId String?
  toUser   User?  @relation(fields: [toUserId], references: [id])

  /// report | presentation | acceptance | noPassport | rfi | document | prescription | task | zayavka | idle | safety
  kind     String
  title    String
  subtitle String
  at       DateTime @default(now())
  read     Boolean  @default(false)
  /// JSON: {screen, params} — куда ведёт тап.
  link     String?

  @@index([toRole, read])
}
