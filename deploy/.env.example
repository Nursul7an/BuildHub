# Настройки развёртывания. Скопируйте в .env рядом и заполните:
#   cp .env.example .env
#
# Файл .env содержит пароль базы и секреты подписи — в репозиторий он
# не попадает (см. .gitignore).

# Домен, направленный A-записью на IP сервера. Caddy получит по нему
# сертификат Let's Encrypt. Без домена сертификата не будет, а без HTTPS
# браузер не отдаст камеру и геолокацию — отчёт с фото не сдать.
DOMAIN=build-hub.example.kg

# --- База ---------------------------------------------------------------

POSTGRES_DB=buildhub
POSTGRES_USER=buildhub
# Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Секреты ------------------------------------------------------------

# Подпись токенов доступа. Сгенерировать: openssl rand -hex 32
# Сервер не запустится, если оставить пустым или вписать отладочное
# значение из репозитория.
JWT_SECRET=

# Подпись ссылок на файлы. Пусто — берётся JWT_SECRET. Задавать отдельно
# стоит затем, чтобы утечка одного не отдавала другое.
FILE_SIGNING_SECRET=

# Токен для выгрузки /metrics. Пусто — ручка открыта без токена.
METRICS_TOKEN=

# --- Прочее -------------------------------------------------------------

LOG_LEVEL=info
