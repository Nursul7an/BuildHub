# Скомпилированный вывод рядом с исходниками. Vite разрешает .js раньше .ts,
# поэтому такой файл незаметно подменяет собой исходник: сборка уходит
# в прод из устаревшего кода, а исходник правится вхолостую.
apps/web/src/**/*.js
apps/web/vite.config.js
*.tsbuildinfo
